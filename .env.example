# Example only. Set real values in your own environment; never commit secrets.
FOMO_MODEL_PATH=/absolute/path/to/your-trained-fomo-checkpoint
FOMO_API_TOKEN=replace-with-a-long-random-secret
FOMO_HOST=127.0.0.1
FOMO_PORT=8765

# Optional scoped local memory: configure all three together.
# FOMO_MEMORY_DB_PATH=/private/path/to/fomo-memory.sqlite3
# FOMO_EMBEDDING_MODEL_PATH=/absolute/path/to/local-embedding-model
# FOMO_MEMORY_SCOPE_ID=single-operator

# Optional tools are disabled unless explicitly enabled (0 or 1).
# FOMO_ENABLE_WEB_RESEARCH=0
# FOMO_ENABLE_SANDBOX_EXECUTION=0
# External isolated sandbox configuration is needed if execution is enabled.
# FOMO_SANDBOX_URL=https://your-isolated-sandbox.example
# FOMO_SANDBOX_TOKEN=replace-with-a-separate-secret